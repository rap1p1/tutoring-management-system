DB_HOST=localhost
DB_PORT=5432
DB_NAME=Gia_Su
DB_USER=postgres
DB_PASSWORD=your_password
PORT=3000

# Google OAuth (tạo tại https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Gmail SMTP - App Password (bật 2FA trên Gmail, tạo App Password tại https://myaccount.google.com/apppasswords)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# AWS S3 (tạo IAM User với quyền AmazonS3FullAccess, tạo S3 Bucket)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-bucket-name